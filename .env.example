# Steera — variáveis de ambiente
# Copie para .env.local e preencha. Veja docs/SETUP.md.
#
# Usamos as chaves novas do Supabase (sb_publishable_… / sb_secret_…), não as
# antigas anon / service_role em JWT — essas serão desativadas até o fim de 2026.

# Supabase → Project Settings → API Keys → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_…)
# Vai para o navegador de propósito. Quem protege os dados é o RLS, não o segredo
# desta chave.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase → Project Settings → API Keys → Secret key (sb_secret_…)
# Carrega BYPASSRLS: ignora toda política do banco. Só é usada no servidor, para
# convidar membros. Nunca exponha no cliente e nunca comite o .env.local.
SUPABASE_SECRET_KEY=

# URL publica do app, usada para montar o link dos e-mails de convite.
# Em producao, a URL real (https://...). Em desenvolvimento pode ficar vazia,
# que o padrao e http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
